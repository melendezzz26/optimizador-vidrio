DATABASE_URL=postgresql+psycopg://newglass_example:not-a-real-password@127.0.0.1:5432/newglass_example
# Generar una clave propia fuera de Git; vacío intencionalmente (no permite arrancar).
SECRET_KEY=
TOKEN_MINUTOS=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opcionales PostgreSQL: descomentar y completar solo tras elegir límites.
# No son límites recomendados ni verificados para Supabase.
# DB_POOL_SIZE=<entero mayor o igual a 1>
# DB_MAX_OVERFLOW=<entero mayor o igual a 0>
# DB_POOL_TIMEOUT=<segundos enteros mayor o igual a 1>
# DB_CONNECT_TIMEOUT=<segundos enteros mayor o igual a 1>
# Staging: DATABASE_URL externa con TLS según endpoint (sslmode=require si corresponde).
